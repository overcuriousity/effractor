+
+test('a drawn host gains the addresses of its interfaces; unticked, nothing of it', () => {
+  const d = office();
+  d.entities.gw = { kind: 'host', label: 'gateway', addresses: ['10.0.1.1'] };
+  d.associations.a3 = { kind: 'attached', from: 'gw', to: 'lan' };
