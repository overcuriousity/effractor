+
+test('the router a DHCP answer names is offered as one', () => {
+  const d = office();
+  const scan = read('announced.xml');
+  assert.deepEqual(D.gateways(scan.pre), ['10.0.1.1']);
+  assert.deepEqual(scan.asks, []);
